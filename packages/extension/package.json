{
  "name": "agentflow",
  "displayName": "AgentFlow \u2014 Ticket to PR",
  "description": "Turn a ticket into a reviewed, tested, gated pull request",
  "version": "0.0.1",
  "private": true,
  "publisher": "buddhanag12",
  "repository": {
    "type": "git",
    "url": "https://github.com/BuddhaNag12/agentic-extension.git"
  },
  "keywords": [
    "agent",
    "jira",
    "pull request",
    "code review",
    "claude"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "tsc -b && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license --out ../../agentflow.vsix"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentflow",
          "title": "AgentFlow",
          "icon": "resources/agentflow.svg"
        }
      ]
    },
    "views": {
      "agentflow": [
        {
          "id": "agentflow.runs",
          "name": "Runs"
        },
        {
          "id": "agentflow.inbox",
          "name": "Needs You"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentflow.runs",
        "contents": "No runs yet.\n[Open the dashboard](command:agentflow.openDashboard)\n[Start a run](command:agentflow.createRun)\n[Review a pull request](command:agentflow.reviewPullRequest)"
      }
    ],
    "commands": [
      {
        "command": "agentflow.openDashboard",
        "title": "AgentFlow: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "agentflow.createRun",
        "title": "AgentFlow: Start Run from Ticket",
        "icon": "$(add)"
      },
      {
        "command": "agentflow.refresh",
        "title": "AgentFlow: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "agentflow.openRun",
        "title": "AgentFlow: Open Run Detail"
      },
      {
        "command": "agentflow.cancelRun",
        "title": "AgentFlow: Cancel Run",
        "icon": "$(stop-circle)"
      },
      {
        "command": "agentflow.answerNext",
        "title": "AgentFlow: Answer Next Question"
      },
      {
        "command": "agentflow.showLog",
        "title": "AgentFlow: Show Orchestrator Log"
      },
      {
        "command": "agentflow.restartOrchestrator",
        "title": "AgentFlow: Restart Orchestrator"
      },
      {
        "command": "agentflow.reviewPullRequest",
        "title": "AgentFlow: Review a GitHub Pull Request",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "agentflow.setGitHubToken",
        "title": "AgentFlow: Set GitHub Token"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentflow.openDashboard",
          "when": "view == agentflow.runs",
          "group": "navigation@0"
        },
        {
          "command": "agentflow.createRun",
          "when": "view == agentflow.runs",
          "group": "navigation@1"
        },
        {
          "command": "agentflow.refresh",
          "when": "view == agentflow.runs",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "agentflow.cancelRun",
          "when": "view == agentflow.runs && viewItem == run",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "AgentFlow",
      "properties": {
        "agentflow.concurrency.maxActiveRuns": {
          "type": "number",
          "default": 4,
          "description": "Maximum runs executing at once. Lower this on machines under 16 GB."
        },
        "agentflow.concurrency.maxConcurrentGateJobs": {
          "type": "number",
          "default": 2,
          "description": "Maximum builds/test suites at once. Metered separately from model calls."
        },
        "agentflow.orchestrator.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Spawn the orchestrator daemon on activation."
        },
        "agentflow.ui.openDashboardOnStart": {
          "type": "boolean",
          "default": true,
          "description": "Open the AgentFlow dashboard in an editor tab when the orchestrator connects."
        },
        "agentflow.ui.openDashboardOnClick": {
          "type": "boolean",
          "default": true,
          "description": "Reveal the AgentFlow dashboard in an editor tab when the AgentFlow sidebar is opened."
        }
      }
    }
  },
  "devDependencies": {
    "@agentflow/core": "0.0.1",
    "@agentflow/orchestrator": "0.0.1",
    "@agentflow/protocol": "0.0.1",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "vscode-jsonrpc": "^8.2.1"
  }
}
